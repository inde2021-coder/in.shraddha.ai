# Copy these values from Firebase Console > Project settings > Your apps > Android app.
# Do not commit local.properties. The Firebase client config is not a server secret,
# but access must still be protected by Firestore/Storage Security Rules and App Check.
FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
FIREBASE_APP_ID=1:YOUR_SENDER_ID:android:YOUR_ANDROID_APP_ID
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_SENDER_ID=YOUR_FIREBASE_SENDER_ID
FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_STORAGE_BUCKET
